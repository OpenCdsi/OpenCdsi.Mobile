<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="opencdsi-github" value="https://nuget.pkg.github.com/OpenCdsi/index.json" />
  </packageSources>

  <!--
    GitHub Packages requires authentication to restore NuGet packages even when both the
    package and its source repository are public - and OpenCdsi.VaxEngine.Core is published from a
    DIFFERENT repo (OpenCdsi/VaxEngine) than this one, so the Actions-provided GITHUB_TOKEN
    (which only covers same-repo packages) doesn't work here. Set these two env vars before
    restoring:

      GITHUB_ACTOR   - your GitHub username
      GITHUB_TOKEN   - a classic PAT with the read:packages scope (in CI, the NUGET_READ_PAT
                       repo secret - see .github/workflows/build-android.yml)
  -->
  <packageSourceCredentials>
    <opencdsi-github>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </opencdsi-github>
  </packageSourceCredentials>
</configuration>
